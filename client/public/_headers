# Cloudflare Pages headers.
#
# The API sets its own headers via helmet; these cover the static frontend.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed asset filenames change on every build, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point must never be cached, or a redeploy would not reach anyone.
/index.html
  Cache-Control: no-cache
