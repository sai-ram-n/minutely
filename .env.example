# Minutely — server environment
# Copy this file to server/.env and fill in real values:
#     cp .env.example server/.env
#
# Never commit server/.env — it is gitignored. In production these are set as
# environment variables on the host (Render), not as a file.

# --- Required ---------------------------------------------------------------

# Groq API key — https://console.groq.com  (free tier, no card required)
# The server refuses to start without this.
GROQ_API_KEY=your_key_here

# --- Database ---------------------------------------------------------------

# Leave BOTH unset locally to use file:./local.db (no cloud setup needed).
# In production these must point at hosted Turso: the host's filesystem is
# ephemeral, so a local SQLite file would be wiped on every restart.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_turso_token

# --- Server -----------------------------------------------------------------

PORT=3001

# Locks CORS to your deployed frontend. Never "*".
# Local dev also accepts http://localhost:5173 automatically.
FRONTEND_ORIGIN=https://your-app.pages.dev

# development | production | test
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
